# Venta Online — API. Usa DB_SCHEMA + search_path (no uses ?schema= en DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/venta_online"
DB_SCHEMA=WVENTA_ONLINE
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-too-min-16-chars
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
