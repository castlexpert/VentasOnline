{
  "name": "venta-online-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:railway": "sequelize-cli db:migrate --config config/database.cjs && node dist/index.js",
    "db:ensure": "tsx src/db/ensureDatabase.ts",
    "db:migrate": "sequelize-cli db:migrate --config config/database.cjs",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/database.cjs",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "tsx src/db/setup.ts",
    "site-index:sync": "node dist/commands/syncSiteIndex.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "resend": "^4.0.0",
    "sequelize": "^6.37.3",
    "twilio": "^5.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/twilio": "^3.19.3",
    "eslint": "^9.0.0",
    "sequelize-cli": "^6.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
